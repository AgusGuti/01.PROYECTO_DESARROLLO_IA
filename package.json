{
  "name": "print3d-planner",
  "version": "0.1.0",
  "private": true,
  "description": "3D print management, costing and scheduling (MEAN + LangChain assistant)",
  "type": "module",
  "engines": {
    "node": "^22.22.3",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "doctor": "node scripts/doctor.mjs",
    "prepare": "husky",
    "dev": "concurrently -n api,web,bot -c blue,green,magenta \"npm run dev:api\" \"npm run dev:web\" \"npm run dev:assistant\"",
    "dev:api": "npm run dev -w @print3d/api",
    "dev:web": "npm run start -w @print3d/web",
    "dev:assistant": "node scripts/py.mjs python -m assistant",
    "db:up": "docker compose up -d --wait mongo",
    "db:down": "docker compose stop mongo",
    "db:shell": "docker compose exec mongo mongosh print3d",
    "db:indexes": "npm run db:indexes -w @print3d/api",
    "db:seed": "npm run db:seed -w @print3d/api",
    "db:seed:filaments": "npm run db:seed:filaments -w @print3d/api",
    "db:seed:parts": "npm run db:seed:parts -w @print3d/api",
    "db:seed:projects": "npm run db:seed:projects -w @print3d/api",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck:api && npm run typecheck:web && npm run typecheck:tools",
    "typecheck:api": "npm run typecheck -w @print3d/api",
    "typecheck:web": "npm run typecheck -w @print3d/web",
    "arch": "depcruise apps/api/src apps/web/src --config .dependency-cruiser.cjs",
    "test": "npm run test:guards && npm run test:mcp && npm run test:api && npm run test:web",
    "test:guards": "node --test scripts/ai/guards/guards.test.mjs",
    "test:mcp": "node --test scripts/mcp/gcode-import-core.test.mjs",
    "test:api": "npm run test -w @print3d/api",
    "test:int": "npm run test:int -w @print3d/api",
    "test:web": "npm run test -w @print3d/web",
    "test:e2e": "node scripts/e2e.mjs",
    "build": "npm run build -w @print3d/api && npm run build -w @print3d/web",
    "contract": "node scripts/contract.mjs",
    "contract:check": "node scripts/contract.mjs --check",
    "guard:scan": "node scripts/ai/guard-scan.mjs",
    "ai:sync": "node scripts/ai/sync-agents.mjs",
    "ai:check": "node scripts/ai/sync-agents.mjs --check",
    "py": "node scripts/py.mjs",
    "py:lint": "node scripts/py.mjs ruff check . && node scripts/py.mjs ruff format --check .",
    "py:type": "node scripts/py.mjs mypy",
    "py:test": "node scripts/py.mjs pytest",
    "secrets": "node scripts/secrets-scan.mjs",
    "audit": "npm audit --audit-level=high",
    "verify:quick": "node scripts/verify.mjs --quick",
    "verify": "node scripts/verify.mjs",
    "typecheck:tools": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/mcp": "0.0.83",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@upstash/context7-mcp": "4.4.4",
    "angular-eslint": "22.6.0",
    "concurrently": "10.0.6",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "vite": "8.3.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "mongodb-memory-server@11.3.0": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true
  }
}
