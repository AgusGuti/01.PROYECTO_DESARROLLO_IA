# Copy to .env (never commit .env). Every variable is validated at startup
# by apps/api/src/config/env.ts and apps/assistant/src/assistant/config.py.

# --- API (Express) ---
NODE_ENV=development
# EXC-0001: the API has no authentication yet, so it must only listen on loopback.
HOST=127.0.0.1
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/print3d?replicaSet=rs0
CORS_ORIGINS=http://localhost:4200
LOG_LEVEL=info
ASSISTANT_URL=http://127.0.0.1:8000

# --- Assistant (Python / LangChain) ---
ASSISTANT_HOST=127.0.0.1
ASSISTANT_PORT=8000
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
API_BASE_URL=http://127.0.0.1:3000
