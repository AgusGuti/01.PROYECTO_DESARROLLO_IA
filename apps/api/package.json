{
  "name": "@print3d/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "openapi": "tsx scripts/generate-openapi.ts",
    "db:indexes": "tsx --env-file-if-exists=../../.env scripts/ensure-indexes.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env scripts/seed-printers.ts",
    "db:seed:filaments": "tsx --env-file-if-exists=../../.env scripts/seed-filaments.ts",
    "db:seed:parts": "tsx --env-file-if-exists=../../.env scripts/seed-parts.ts",
    "db:seed:projects": "tsx --env-file-if-exists=../../.env scripts/seed-projects.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "mongoose": "9.11.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "vitest": "5.0.4",
    "yaml": "2.9.1"
  }
}
