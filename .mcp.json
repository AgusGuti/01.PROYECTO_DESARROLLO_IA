{
  "mcpServers": {
    "angular-cli": {
      "command": "node",
      "args": ["node_modules/@angular/cli/bin/ng.js", "mcp", "--read-only", "--root", "apps/web"]
    },
    "context7": {
      "command": "node",
      "args": ["node_modules/@upstash/context7-mcp/dist/index.js"]
    },
    "gcode-import": {
      "command": "node",
      "args": ["scripts/mcp/gcode-import-server.mjs", "--root", "D:\\3D_Printings\\00.GCODES"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_MCP_TOKEN}",
        "X-MCP-Readonly": "true",
        "X-MCP-Toolsets": "repos,issues,pull_requests,actions"
      }
    },
    "playwright": {
      "command": "node",
      "args": [
        "node_modules/@playwright/mcp/cli.js",
        "--isolated",
        "--allowed-origins",
        "http://localhost:4200;http://127.0.0.1:3000"
      ]
    }
  }
}
